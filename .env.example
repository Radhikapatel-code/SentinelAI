# ──────────────────────────────────────────────
# SentinelAI Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# --- API Server ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Dashboard ---
# URL where the FastAPI backend is running
API_URL=http://127.0.0.1:8000

# --- LLM Explanation Layer (Optional) ---
# Get your API key from: https://platform.openai.com/api-keys
# If not set, the system falls back to SHAP-based text explanations.
OPENAI_API_KEY=your-openai-api-key-here

# --- Kaggle (for downloading evaluation dataset) ---
# Get credentials from: https://www.kaggle.com/settings
# KAGGLE_USERNAME=your-username
# KAGGLE_KEY=your-api-key
